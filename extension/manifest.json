{
  "manifest_version": 3,
  "name": "AI Study Sidekick",
  "version": "1.1.0",
  "description": "Trợ lý AI trong Chrome Side Panel với hỗ trợ 9Router: hỏi về trang đang mở, giải thích và dịch đoạn văn được chọn.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mở AI Study Sidekick"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
