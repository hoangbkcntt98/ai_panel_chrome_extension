# ===== 9Router (mặc định cho bản này) =====
AI_PROVIDER=9router
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=your-api-key-from-9router-dashboard
AI_MODEL=if/glm-4.7

# Tuỳ chọn: giới hạn model người dùng được chọn trong Side Panel.
# Để trống = cho phép mọi model mà 9Router của bạn expose.
ALLOWED_MODELS=

PORT=8787

# ===== Nếu muốn quay lại OpenAI trực tiếp =====
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-5
