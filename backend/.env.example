# ===== 9Router (mặc định cho bản này) =====
AI_PROVIDER=9router
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=your-api-key-from-9router-dashboard
AI_MODEL=if/glm-4.7

# Tuỳ chọn: giới hạn model người dùng được chọn trong Side Panel.
# Để trống = cho phép mọi model mà 9Router của bạn expose.
ALLOWED_MODELS=

PORT=8787

# ===== PostgreSQL cho lưu lịch sử chat =====
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ai_sidekick_db
PG_USER=ai_sidekick
PG_PASSWORD=ai_sidekick_pass

# ===== Add To Anki =====
# Existing Anki database/table; no automatic table creation.
# AI generation uses AI_PROVIDER / AI_BASE_URL / AI_API_KEY above and panel model.
ANKI_AI_DATABASE=
ANKI_AI_NOTES_TABLE=anki_ai_notes
ANKI_AI_NOTE_TYPE=AIWordWithImage
ANKI_AI_TAGS=ai_sidekick
# Optional Anki connection overrides; otherwise use PG_* above.
# DB_HOST=localhost
# DB_PORT=5432
# ANKI_AI_DB_USER=
# ANKI_AI_DB_PASSWORD=
# Destination language comes from extension Settings (Auto defaults to Vietnamese).

# ===== Nếu muốn quay lại OpenAI trực tiếp =====
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-5
